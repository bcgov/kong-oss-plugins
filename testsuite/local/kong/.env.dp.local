KONG_DATABASE: off

KONG_NGINX_WORKER_PROCESSES: '1'
KONG_NGINX_PROXY_INCLUDE: /tmp/kong/nginx-redis.kong.conf

KONG_LOG_LEVEL: debug

KONG_ADMIN_ACCESS_LOG: /dev/stdout
KONG_ADMIN_ERROR_LOG: /dev/stderr
KONG_PROXY_ACCESS_LOG: /dev/stdout
KONG_PROXY_ERROR_LOG: /dev/stderr

KONG_ADMIN_LISTEN: 0.0.0.0:8001
KONG_STATUS_LISTEN: 0.0.0.0:8007

KONG_DNS_ORDER: 'LAST,A'
KONG_TRUSTED_IPS: '0.0.0.0/0,::/0'
KONG_REAL_IP_HEADER: X-Forwarded-For

KONG_ROLE: data_plane
KONG_CLUSTER_CERT: /tmp/kong/cluster.crt
KONG_CLUSTER_CERT_KEY: /tmp/kong/cluster.key

KONG_CLUSTER_CONTROL_PLANE: kong-cp:8005
KONG_CLUSTER_TELEMETRY_ENDPOINT: kong-cp:8006
KONG_CLUSTER_DP_LABELS: deployment:compose,region:ca-west

